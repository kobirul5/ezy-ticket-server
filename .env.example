# Database
DATABASE_URL="postgresql://user:password@localhost:5432/ezyticket?schema=public"

# Application
NODE_ENV=development
PORT=5000
SERVER_URL="http://localhost:5000"
BCRYPT_SALT_ROUNDS=12
PLATFORM_CHARGE_PERCENTAGE=10

# JWT Secrets
JWT_SECRET="your_jwt_secret_key"
EXPIRES_IN="7d"
REFRESH_TOKEN_SECRET="your_refresh_token_secret_key"
REFRESH_TOKEN_EXPIRES_IN="30d"
RESET_PASS_TOKEN="your_reset_pass_token_secret"
RESET_PASS_TOKEN_EXPIRES_IN="15m"

# Client Frontend Links
FRONTEND_BASE_URL="http://localhost:5173"
CLIENT_URL="http://localhost:5173"
APP_DASHBOARD_URL="http://localhost:5173/dashboard"
RESET_PASS_LINK="http://localhost:5173/reset-password"

# SSLCommerz Payment Gateway
STORE_ID="your_sslcommerz_store_id"
STORE_PASS="your_sslcommerz_store_pass"
IS_LIVE="false"

# Stripe Payment Gateway
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Email / SMTP
EMAIL="your_email@gmail.com"
APP_PASS="your_app_password"
smtp_server="smtp.gmail.com"
smtp_port=587

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
